---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noindex>
  <section class="container-x py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-4xl font-bold sm:text-5xl">Lost signal</h1>
    <p class="mt-4 text-slate-400">That page flew out of range. Let's get you back on course.</p>
    <a href="/" class="btn-primary mt-8">Return home</a>
  </section>
</BaseLayout>
