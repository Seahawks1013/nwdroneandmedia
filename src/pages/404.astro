---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Page Not Found" noindex>
  <PageHero eyebrow="404" title="Lost signal" intro="That page flew out of range." />
  <section class="bg-fog py-20 text-center">
    <a href="/" class="inline-flex items-center justify-center rounded-full bg-spruce px-7 py-3.5 text-[0.9375rem] font-medium text-fog transition hover:bg-spruce2">
      Back to the home page
    </a>
  </section>
</BaseLayout>
