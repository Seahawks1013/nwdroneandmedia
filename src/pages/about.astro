---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import NotchCard from '../components/NotchCard.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { SITE } from '../consts';
import { PHOTOS } from '../data/media';
import { PILLARS, TAGS } from '../data/home';

const { portrait, smiling, shooting, packing, gear } = PHOTOS;

// What DJ brings to every shoot (visible in the photos). Update as the kit changes.
const kit = [
  ['Sony full-frame mirrorless', 'Cinematic 4K video with clean low-light performance for receptions and evening events.'],
  ['Licensed drone', 'FAA Part 107 aerials: venue establishing shots, the ceremony from above, event overviews.'],
  ['Portable power station', 'All-day power on location, so batteries are never the reason a moment gets missed.'],
  ['Weatherproof camera pack', 'Everything packed and protected, rain or shine, from the rehearsal to the last dance.'],
];
---

<BaseLayout
  title="About DJ Riley"
  description="DJ Riley founded NW Drone & Media in Woodland, WA. Wedding films, event videography and FAA Part 107 drone footage for Portland, Vancouver WA and the surrounding areas."
>
  <PageHero
    eyebrow="About"
    title="Meet DJ Riley"
    intro="Founder, filmmaker and FAA Part 107 licensed drone pilot. Based in Woodland, WA."
  />

  <!-- Story -->
  <section class="bg-fog py-24 sm:py-32">
    <div class="mx-auto grid max-w-[1240px] grid-cols-[minmax(0,1fr)] items-start gap-14 px-6 sm:px-9 md:grid-cols-[minmax(0,.85fr)_minmax(0,1.15fr)]">
      <div>
        <SectionTitle lead="DJ's" rest="story" />
        <!-- Personalize: replace these paragraphs with DJ's story in his own words —
             how he got started, his first wedding, why he picked up a drone. -->
        <p class="mt-7 max-w-[38ch] text-[17px] font-medium leading-relaxed text-inkk/80">
          {SITE.owner} founded {SITE.name} in Woodland, Washington, with a simple idea: the biggest days of people's lives
          deserve to be filmed with care — on the ground and from the air.
        </p>
        <p class="mt-4 max-w-[38ch] text-[15px] font-medium leading-relaxed text-inkk/80">
          Today DJ films weddings, community events and local businesses across Portland, Vancouver WA and the surrounding
          areas. He's the person behind the camera, the licensed pilot flying the drone, and the editor cutting your film —
          so the vision stays the same from the first call to the final export.
        </p>
        <p class="mt-4 max-w-[38ch] text-[15px] font-medium leading-relaxed text-inkk/80">
          Whether it's Jake and Kenna's wedding day or the Port of Woodland's end-of-summer social, the goal is the same: a film
          that feels like being there.
        </p>
        <ul class="mt-9 flex flex-wrap gap-2">
          {TAGS.map((t) => <li class="rounded-full px-4 py-2 text-[13px] text-inkk/70 ring-1 ring-inkk/15">{t}</li>)}
        </ul>
      </div>
      <div class="grid grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] gap-4">
        <NotchCard notchBg="#E9ECE6" class="aspect-[4/5]" href="/portfolio/" label="See DJ's work">
          <img src={portrait.src} alt={portrait.alt} width={portrait.width} height={portrait.height} fetchpriority="high" class="h-full w-full object-cover" style={`object-position: ${portrait.position}`} />
        </NotchCard>
        <div class="flex flex-col gap-4">
          <div class="aspect-[4/5] overflow-hidden rounded-[18px]">
            <img src={smiling.src} alt={smiling.alt} width={smiling.width} height={smiling.height} loading="lazy" decoding="async" class="h-full w-full object-cover" style={`object-position: ${smiling.position}`} />
          </div>
          <div class="rounded-[18px] bg-spruce p-6 text-fog">
            <p class="font-display text-[1.6rem] font-semibold leading-tight">{SITE.city}, {SITE.region}</p>
            <p class="mt-2 text-[13px] font-medium leading-relaxed text-fog/80">Founded here. Serving Portland, Vancouver WA and the surrounding areas.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="bg-fog pb-24">
    <div class="mx-auto grid max-w-[1100px] gap-5 px-6 sm:px-9 md:grid-cols-3">
      {
        PILLARS.map((p) => (
          <article class="rounded-[20px] bg-white/70 p-8 ring-1 ring-inkk/10 transition duration-200 hover:ring-inkk/25">
            <span class="mb-6 grid h-12 w-12 place-items-center rounded-full bg-spruce">
              <svg viewBox="0 0 24 24" class="h-5 w-5 fill-brass" aria-hidden="true"><path d={p.icon} /></svg>
            </span>
            <h3 class="font-display text-[1.45rem] font-semibold leading-tight">{p.t}</h3>
            <p class="mt-3 text-[14px] font-medium leading-relaxed text-inkk/70">{p.d}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- On every shoot -->
  <section class="bg-fog px-2 pb-24 sm:px-3">
    <div class="rounded-[30px] bg-cream py-20 sm:py-24">
      <div class="mx-auto grid max-w-[1240px] grid-cols-[minmax(0,1fr)] items-center gap-12 px-6 sm:px-9 md:grid-cols-2">
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2 aspect-[3/2] overflow-hidden rounded-[18px]">
            <img src={packing.src} alt={packing.alt} width={packing.width} height={packing.height} loading="lazy" decoding="async" class="h-full w-full object-cover" style={`object-position: ${packing.position}`} />
          </div>
          <div class="aspect-square overflow-hidden rounded-[18px]">
            <img src={shooting.src} alt={shooting.alt} width={shooting.width} height={shooting.height} loading="lazy" decoding="async" class="h-full w-full object-cover" style={`object-position: ${shooting.position}`} />
          </div>
          <div class="aspect-square overflow-hidden rounded-[18px]">
            <img src={gear.src} alt={gear.alt} width={gear.width} height={gear.height} loading="lazy" decoding="async" class="h-full w-full object-cover" style={`object-position: ${gear.position}`} />
          </div>
        </div>
        <div>
          <SectionTitle lead="On" rest="every shoot" />
          <dl class="mt-8">
            {
              kit.map(([name, text]) => (
                <div class="border-t border-inkk/10 py-5">
                  <dt class="font-display text-[1.3rem] font-semibold">{name}</dt>
                  <dd class="mt-1 text-[14px] font-medium leading-relaxed text-inkk/70">{text}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-fog2 py-24 text-center">
    <div class="mx-auto max-w-[1240px] px-6 sm:px-9">
      <SectionTitle lead="Work" rest="with DJ" />
      <p class="mx-auto mt-6 max-w-[44ch] text-[16px] font-medium leading-relaxed text-inkk/80">
        Weddings, events or drone footage — tell DJ when and where, and you'll hear back with availability and a price.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 rounded-full bg-spruce px-7 py-3.5 text-[15px] font-medium text-fog transition-all duration-200 hover:bg-spruce2">Check your date</a>
        <a href="/portfolio/" class="inline-flex items-center justify-center rounded-full px-7 py-3.5 text-[15px] text-inkk/70 ring-1 ring-inkk/20 transition hover:ring-inkk/50">See the portfolio</a>
      </div>
    </div>
  </section>
</BaseLayout>
