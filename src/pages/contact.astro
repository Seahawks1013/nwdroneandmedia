---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import BookingForm from '../components/BookingForm.astro';
import { SITE } from '../consts';

const info = [
  ['Email', SITE.email, `mailto:${SITE.email}`],
  ['Phone', SITE.phone, `tel:${SITE.phone.replace(/\D/g, '')}`],
  ['Based in', `${SITE.city}, ${SITE.region}`],
  ['Service area', SITE.serviceArea],
];
---

<BaseLayout
  title="Contact & Booking"
  description="Check your date for a wedding film or request a quote for aerial, real estate or inspection work in Walla Walla and across the Pacific Northwest."
>
  <PageHero eyebrow="Contact" title="Check your date" intro="Tell us when and where. You'll hear back within a day with availability and a full price — no call required first." />

  <section id="book" class="bg-fog2 py-24">
    <div class="mx-auto grid max-w-[1240px] items-start gap-14 px-6 sm:px-9 md:grid-cols-2">
      <div>
        <SectionTitle lead="Say" rest="hello" />
        <p class="mt-6 max-w-[40ch] text-[16px] font-medium leading-relaxed text-inkk/80">
          Weddings, elopements, listings, job sites or brand work — send the basics and we'll come back with a plan.
        </p>
        <dl class="mt-10 max-w-[420px] text-[15px]">
          {
            info.map(([label, value, href]) => (
              <div class="flex justify-between gap-6 border-t border-inkk/10 py-4 last:border-b">
                <dt class="text-inkk/50">{label}</dt>
                <dd class="text-right font-medium text-inkk/80">{href ? <a href={href} class="hover:text-inkk">{value}</a> : value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-10 overflow-hidden rounded-[22px] ring-1 ring-inkk/10">
          <iframe
            title={`Map of ${SITE.city}, ${SITE.region}`}
            src={`https://www.google.com/maps?q=${encodeURIComponent(`${SITE.city}, ${SITE.region}`)}&output=embed`}
            class="h-64 w-full grayscale"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
      <BookingForm />
    </div>
  </section>
</BaseLayout>
