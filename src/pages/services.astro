---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PricingCard from '../components/PricingCard.astro';
import { WEDDING_PLANS, EVENT_PLANS } from '../data/pricing';
import { STEPS } from '../data/home';
import { PHOTOS } from '../data/media';

const { gear } = PHOTOS;
---

<BaseLayout
  title="Pricing"
  description="Wedding videography from $300, event coverage from $400 and drone shots from $100. Pricing for NW Drone & Media in Woodland, WA, serving Portland and Vancouver."
>
  <PageHero
    eyebrow="Pricing"
    title="Weddings, events & drone"
    intro="Straightforward pricing with add-ons listed up front. Not sure what you need? Send your date and we'll put together a quote."
  />

  <nav aria-label="Pricing sections" class="bg-fog pt-16">
    <ul class="mx-auto flex max-w-[1240px] flex-wrap justify-center gap-2 px-6 sm:px-9">
      {
        [
          ['#weddings', 'Weddings'],
          ['#events', 'Special events'],
          ['#drone-shots', 'Drone shots'],
        ].map(([href, label]) => (
          <li>
            <a href={href} class="block rounded-full px-5 py-2.5 text-[14px] text-inkk/70 ring-1 ring-inkk/20 transition hover:ring-inkk/50">{label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Weddings -->
  <section id="weddings" class="scroll-mt-24 bg-fog py-24">
    <div class="mx-auto max-w-[1240px] px-6 sm:px-9">
      <div class="grid items-end gap-8 md:grid-cols-[1fr_.9fr]">
        <SectionTitle lead="Wedding" rest="pricing" />
        <p class="max-w-[46ch] text-[15px] font-medium leading-relaxed text-inkk/70">
          Book the full day, or build a custom package around the ceremony or rehearsal. Edited film is priced by length, so you
          only pay for the film you want.
        </p>
      </div>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {WEDDING_PLANS.map((plan) => <PricingCard plan={plan} />)}
      </div>
    </div>
  </section>

  <!-- Special events + drone -->
  <section id="events" class="scroll-mt-24 bg-fog px-2 pb-24 sm:px-3">
    <div class="rounded-[30px] bg-cream py-20 sm:py-24">
      <div class="mx-auto max-w-[1240px] px-6 sm:px-9">
        <div class="grid items-end gap-8 md:grid-cols-[1fr_.9fr]">
          <SectionTitle lead="Special" rest="events" />
          <p class="max-w-[46ch] text-[15px] font-medium leading-relaxed text-inkk/70">
            Community events, socials, celebrations and local businesses. Get a horizontal film for YouTube and your website,
            vertical cuts for Instagram and TikTok, or both.
          </p>
        </div>
        <div class="mt-12 grid gap-5 md:grid-cols-3">
          {EVENT_PLANS.map((plan) => <PricingCard plan={plan} />)}
        </div>
      </div>
    </div>
  </section>

  <!-- Notes -->
  <section class="bg-fog pb-24">
    <div class="mx-auto grid max-w-[1100px] items-center gap-10 px-6 sm:px-9 md:grid-cols-2">
      <div class="aspect-[4/3] overflow-hidden rounded-[22px]">
        <img src={gear.src} alt={gear.alt} width={gear.width} height={gear.height} loading="lazy" decoding="async" class="h-full w-full object-cover" style={`object-position: ${gear.position}`} />
      </div>
      <div>
        <h2 class="font-display text-[clamp(1.8rem,3vw,2.4rem)] font-semibold leading-tight">Good to know</h2>
        <ul class="mt-6 text-[14px]">
          {
            [
              'Field-work minimums cover time on location; edited videos are priced separately as listed.',
              'Drone flights depend on airspace, weather and venue rules. We check your location before you book.',
              'Additional content beyond what a package lists is priced accordingly — just ask.',
              'Based in Woodland, WA. Portland, Vancouver and the surrounding areas are our home turf.',
            ].map((n) => (
              <li class="flex gap-3 border-t border-inkk/10 py-3 text-inkk/70">
                <span class="mt-[7px] h-1.5 w-1.5 flex-none rounded-full bg-brass" aria-hidden="true" />
                {n}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-spruce py-24 text-fog">
    <div class="mx-auto max-w-[1240px] px-6 sm:px-9">
      <div class="grid items-end gap-8 md:grid-cols-[1fr_.9fr]">
        <SectionTitle lead="How" rest="it works" class="text-fog" />
        <p class="max-w-[44ch] text-[15px] font-medium leading-relaxed text-fog/65">
          Four steps from first message to the finished film. No pressure calls, no packages you have to decode.
        </p>
      </div>
      <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          STEPS.map(([title, text], i) => (
            <li class="border-t border-fog/15 pt-5">
              <span class="font-display text-[2rem] font-semibold leading-none text-brass">{i + 1}</span>
              <h3 class="mt-4 font-display text-[1.3rem] font-semibold">{title}</h3>
              <p class="mt-2 text-[14px] font-medium leading-relaxed text-fog/65">{text}</p>
            </li>
          ))
        }
      </ol>
      <div class="mt-16 text-center">
        <a href="/contact/" class="inline-flex items-center justify-center gap-2 rounded-full bg-brass px-7 py-3.5 text-[15px] font-medium text-[#1B1408] transition-all duration-200 hover:-translate-y-[1px] hover:bg-brass2">
          Check your date
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
