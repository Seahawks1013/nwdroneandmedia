---
import Logo from './Logo.astro';
import { NAV_LEFT, NAV_RIGHT, NAV_CTA } from '../consts';

const pill =
  'rounded-full px-4 py-2 text-[14px] text-fog/85 ring-1 ring-fog/20 transition hover:bg-fog/10 hover:text-fog';
---

<nav id="site-nav" class="fixed inset-x-0 top-0 z-50 transition-all duration-300" aria-label="Main">
  <div class="mx-auto flex max-w-[1240px] items-center justify-between gap-6 px-6 py-4 sm:px-9">
    <div class="hidden items-center gap-2 lg:flex">
      {NAV_LEFT.map(({ href, label }) => <a href={href} class={pill}>{label}</a>)}
    </div>
    <Logo />
    <div class="flex items-center gap-2">
      <a href={NAV_RIGHT.href} class={`hidden lg:inline-block ${pill}`}>{NAV_RIGHT.label}</a>
      <a
        href={NAV_CTA.href}
        class="rounded-full bg-brass px-5 py-2 text-[14px] font-medium text-[#1B1408] transition hover:bg-brass2"
        >{NAV_CTA.label}</a
      >
    </div>
  </div>
</nav>

<script>
  // Nav gets a frosted spruce background once the page scrolls past 60px.
  const nav = document.getElementById('site-nav')!;
  const update = () => {
    const scrolled = window.scrollY > 60;
    nav.classList.toggle('bg-spruce/92', scrolled);
    nav.classList.toggle('backdrop-blur-md', scrolled);
  };
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
