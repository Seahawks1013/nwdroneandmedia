---
import type { Plan } from '../data/pricing';

export interface Props {
  plan: Plan;
  cta?: string;
}
const { plan, cta = '/contact/' } = Astro.props;
const f = plan.featured;
---

<article id={plan.id} class:list={['flex scroll-mt-28 flex-col rounded-[22px] p-8', f ? 'bg-spruce text-fog' : 'bg-white/70 text-inkk ring-1 ring-inkk/10']}>
  {plan.kicker && <p class:list={['mb-3 text-[0.6875rem] track uppercase', f ? 'text-brass' : 'text-inkk/70']}>{plan.kicker}</p>}
  <h3 class="font-display text-[1.6rem] font-semibold leading-tight">{plan.name}</h3>
  <p class="mt-4 font-display text-[2.6rem] font-semibold leading-none tracking-tight">{plan.price}</p>
  <p class:list={['mt-2 text-[0.8125rem]', f ? 'text-fog/70' : 'text-inkk/70']}>{plan.unit}</p>
  <ul class="mt-7 text-[0.875rem]">
    {
      plan.includes.map((item) => (
        <li class:list={['flex gap-3 border-t py-3', f ? 'border-fog/15 text-fog/80' : 'border-inkk/10 text-inkk/70']}>
          <span class="mt-[7px] h-1.5 w-1.5 flex-none rounded-full bg-brass" aria-hidden="true" />
          {item}
        </li>
      ))
    }
  </ul>
  {
    plan.addOns && (
      <div class:list={['border-t pt-4', f ? 'border-fog/15' : 'border-inkk/10']}>
        <p class:list={['text-[0.6875rem] track uppercase', f ? 'text-fog/70' : 'text-inkk/70']}>Add-ons</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {plan.addOns.map((a) => (
            <li class:list={['rounded-full px-3 py-1.5 text-[0.8125rem] ring-1', f ? 'text-fog/85 ring-fog/25' : 'text-inkk/70 ring-inkk/15']}>{a}</li>
          ))}
        </ul>
      </div>
    )
  }
  <div class="mt-auto pt-8">
    <a
      href={cta}
      class:list={[
        'inline-flex w-full items-center justify-center gap-2 rounded-full px-7 py-3.5 text-[0.9375rem] font-medium transition-all duration-200',
        f ? 'bg-brass text-[#1B1408] hover:-translate-y-[1px] hover:bg-brass2' : 'bg-spruce text-fog hover:bg-spruce2',
      ]}>Check your date</a
    >
  </div>
</article>
