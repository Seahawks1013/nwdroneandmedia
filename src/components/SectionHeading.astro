---
export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  center?: boolean;
}
const { eyebrow, title, intro, center = false } = Astro.props;
---

<div class:list={['max-w-3xl', center && 'mx-auto text-center']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">{title}</h2>
  {intro && <p class="mt-4 text-lg text-slate-400">{intro}</p>}
</div>
