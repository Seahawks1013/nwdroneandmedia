---
// Shorter version of the home hero for inner pages: same spruce frame,
// tilted landscape backdrop and centered display title.
import Landscape from './Landscape.astro';

export interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<header class="bg-spruce p-2 sm:p-3">
  <div class="relative isolate flex min-h-[56vh] items-end overflow-hidden rounded-[26px] bg-spruce2">
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div
        class="absolute left-1/2 top-1/2 flex w-[150%] gap-3 sm:gap-4"
        style="transform: translate(-50%, -50%) rotate(-11deg) scale(1.18);"
      >
        {
          [[3, 19], [8, 29], [15, 36], [22, 47], [38, 55]].map(([a, b], i) => (
            <div class="flex flex-1 flex-col gap-3 sm:gap-4" style={`margin-top: ${-((i % 3) * 34)}px;`}>
              <Landscape seed={a} class="h-[30vh] rounded-md" />
              <Landscape seed={b} class="h-[36vh] rounded-md" />
            </div>
          ))
        }
      </div>
      <div class="absolute inset-0 bg-spruce/55"></div>
      <div class="absolute inset-0 bg-[radial-gradient(120%_80%_at_50%_78%,rgba(14,22,19,.92),rgba(14,22,19,.35)_60%,rgba(14,22,19,.55))]"></div>
      <div class="absolute inset-x-0 top-0 h-40 bg-gradient-to-b from-spruce/85 to-transparent"></div>
    </div>
    <div class="relative mx-auto w-full max-w-[1240px] px-6 pb-14 pt-36 text-center sm:px-9 sm:pb-20">
      <p class="mb-3 text-[clamp(.72rem,1.5vw,1rem)] track text-fog/80">{eyebrow}</p>
      <h1 class="font-display text-[clamp(2.8rem,8vw,6.5rem)] font-semibold italic leading-[.9] tracking-[-.03em] text-fog">
        {title}
      </h1>
      <div class="mx-auto mt-10 h-px w-24 rule"></div>
      {intro && <p class="mx-auto mt-6 max-w-[52ch] text-[16px] font-medium leading-[1.65] text-fog/85">{intro}</p>}
    </div>
  </div>
</header>
