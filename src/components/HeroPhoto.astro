---
// One photo tile in a hero backdrop. Files come from public/images/hero/
// (<name>-640.webp and <name>-1200.webp, built by scripts/make-hero-images.mjs).
// Decorative: the backdrop sits behind the headline, so alt is empty.
export interface Props {
  photo: string;
  pos?: string;
  class?: string;
}
const { photo, pos = '50% 50%', class: className = '' } = Astro.props;
---

<div class={`overflow-hidden rounded-md bg-spruce2 ${className}`}>
  <img
    src={`/images/hero/${photo}-1200.webp`}
    srcset={`/images/hero/${photo}-640.webp 640w, /images/hero/${photo}-1200.webp 1200w`}
    sizes="(min-width: 768px) 30vw, 40vw"
    alt=""
    decoding="async"
    class="h-full w-full object-cover"
    style={`object-position: ${pos}`}
  />
</div>
