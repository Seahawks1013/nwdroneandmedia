---
import Logo from './Logo.astro';
import { FOOTER_COLUMNS, LEGAL_LINKS, SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="bg-spruce pb-8 pt-20 text-fog">
  <div class="mx-auto max-w-[1240px] px-6 sm:px-9">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <Logo />
        <p class="mt-5 max-w-[32ch] text-[14px] font-medium leading-relaxed text-fog/65">
          Wedding films, event videography and licensed drone footage by {SITE.owner}. Founded in {SITE.city}, {SITE.region} —
          serving Portland, Vancouver WA and the surrounding areas.
        </p>
      </div>
      {
        FOOTER_COLUMNS.map(([heading, links]) => (
          <div>
            <h2 class="font-display font-semibold text-[1.15rem]">{heading}</h2>
            <ul class="mt-4 space-y-2 text-[14px]">
              {links.map(({ label, href }) => (
                <li>
                  <a href={href} class="text-fog/55 transition hover:text-fog" rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t border-fog/15 pt-6 text-[12px] text-fog/40">
      <span>© {year} {SITE.name}. All rights reserved.</span>
      <nav aria-label="Legal">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {LEGAL_LINKS.map(({ href, label }) => <li><a href={href} class="transition hover:text-fog">{label}</a></li>)}
        </ul>
      </nav>
      <span>FAA Part 107 certified · Insured · {SITE.city}, {SITE.region}</span>
    </div>
  </div>
</footer>
