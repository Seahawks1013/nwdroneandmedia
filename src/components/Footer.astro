---
import Logo from './Logo.astro';
import { FOOTER_COLUMNS, LEGAL_LINKS, SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="bg-spruce pb-8 pt-14 text-fog md:pt-20">
  <div class="mx-auto max-w-[1240px] px-6 sm:px-9">
    <div class="grid grid-cols-2 gap-x-8 gap-y-10 md:grid-cols-[1.5fr_1fr_1fr_1fr] md:gap-12">
      <div class="col-span-2 md:col-span-1">
        <Logo variant="footer" />
      </div>
      {
        FOOTER_COLUMNS.map(([heading, links]) => (
          <div>
            <h2 class="font-display font-semibold text-[1.15rem]">{heading}</h2>
            <ul class="mt-4 space-y-2 text-[0.875rem]">
              {links.map(({ label, href }) => (
                <li>
                  <a href={href} class="text-fog/75 transition hover:text-fog" rel={href.startsWith('http') ? 'noopener' : undefined}>{label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-fog/15 pt-6 text-[0.75rem] text-fog/70 md:mt-16">
      <span>© {year} {SITE.name}. All rights reserved.</span>
      <nav aria-label="Legal">
        <ul class="flex flex-wrap gap-x-5 gap-y-2">
          {LEGAL_LINKS.map(({ href, label }) => <li><a href={href} class="transition hover:text-fog">{label}</a></li>)}
        </ul>
      </nav>
      <span>FAA Part 107 certified · Insured · {SITE.city}, {SITE.region}</span>
    </div>
  </div>
</footer>
