---
import { NAV, SITE } from '../consts';
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-950">
  <div class="container-x grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-lg font-semibold text-white">NW Drone <span class="text-brand-400">&amp;</span> Media</p>
      <p class="mt-3 max-w-xs text-sm text-slate-400">
        Aerial photography, cinematic video and drone services from {SITE.city}, {SITE.region}.
      </p>
      <p class="mt-4 text-xs uppercase tracking-widest text-slate-500">FAA Part 107 Certified · Fully Insured</p>
    </div>

    <nav aria-label="Footer">
      <p class="text-sm font-semibold text-white">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV.map(({ href, label }) => <li><a href={href} class="text-slate-400 hover:text-white">{label}</a></li>)}
      </ul>
    </nav>

    <div>
      <p class="text-sm font-semibold text-white">Get in touch</p>
      <ul class="mt-3 space-y-2 text-sm text-slate-400">
        <li><a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a></li>
        {SITE.phone && <li><a href={`tel:${SITE.phone.replace(/\D/g, '')}`} class="hover:text-white">{SITE.phone}</a></li>}
        <li>{SITE.city}, {SITE.region} — serving the Pacific Northwest</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/5 py-6 text-center text-xs text-slate-500">
    © {year} {SITE.name}. All rights reserved.
  </div>
</footer>
