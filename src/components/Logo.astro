---
export interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const c = tone === 'light' ? '#E9ECE6' : '#121A17';
---

<a href="/" class="flex items-center gap-3" style={`color: ${c};`} aria-label="NW Drone & Media home">
  <svg width="30" height="30" viewBox="0 0 26 26" fill="none" aria-hidden="true">
    <circle cx="13" cy="13" r="4.2" stroke="#D2A25E" stroke-width="1.4"></circle>
    <path d="M13 1.5v5M13 19.5v5M1.5 13h5M19.5 13h5" stroke={c} stroke-width="1.4" stroke-linecap="round"></path>
    <circle cx="13" cy="13" r="11.3" stroke={c} stroke-opacity=".28" stroke-width="1"></circle>
  </svg>
  <span class="leading-none">
    <span class="block font-display text-[19px] tracking-tight">NW Drone &amp; Media</span>
    <span class="mt-1 block text-[9px] track text-brass">WEDDINGS · EVENTS · AERIAL</span>
  </span>
</a>
