---
export interface Props {
  tone?: 'light' | 'dark';
  /** Header use: smaller on phones, tagline hidden below the sm breakpoint. */
  compact?: boolean;
}
const { tone = 'light', compact = false } = Astro.props;
const c = tone === 'light' ? '#E9ECE6' : '#121A17';
---

<a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3" style={`color: ${c};`} aria-label="NW Drone & Media home">
  <svg viewBox="0 0 26 26" fill="none" aria-hidden="true" class:list={['flex-none', compact ? 'h-[26px] w-[26px] sm:h-[30px] sm:w-[30px]' : 'h-[30px] w-[30px]']}>
    <circle cx="13" cy="13" r="4.2" stroke="#D2A25E" stroke-width="1.4"></circle>
    <path d="M13 1.5v5M13 19.5v5M1.5 13h5M19.5 13h5" stroke={c} stroke-width="1.4" stroke-linecap="round"></path>
    <circle cx="13" cy="13" r="11.3" stroke={c} stroke-opacity=".28" stroke-width="1"></circle>
  </svg>
  <span class="leading-none">
    <span class:list={['block whitespace-nowrap font-display tracking-tight', compact ? 'text-[16px] sm:text-[19px]' : 'text-[19px]']}>NW Drone &amp; Media</span>
    <span class:list={['mt-1 whitespace-nowrap text-[9px] track text-brass', compact ? 'hidden sm:block' : 'block']}>WEDDINGS · EVENTS · AERIAL</span>
  </span>
</a>
