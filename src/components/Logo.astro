---
// Brand logo (gold, transparent WebPs built from brand/logo-original.jpg by
// scripts/make-logo-assets.mjs). Only use on dark backgrounds: the gold has too
// little contrast on the light fog/cream sections.
//
// - header: diamond mark on small phones, mark + wordmark from 480px up
// - footer: full stacked logo
export interface Props {
  variant?: 'header' | 'footer';
}
const { variant = 'header' } = Astro.props;
const name = 'Northwest Drone and Media';
---

<a href="/" class="inline-flex shrink-0 items-center rounded-sm" aria-label={`${name} home`}>
  {
    variant === 'header' ? (
      <picture>
        <source media="(min-width: 480px)" srcset="/images/brand/logo-horizontal.webp" width="720" height="112" />
        <img
          src="/images/brand/logo-mark.webp"
          width="160"
          height="166"
          alt={name}
          class="h-[36px] w-auto min-[480px]:h-[30px] sm:h-[38px] lg:h-[50px]"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    ) : (
      <img src="/images/brand/logo-full.webp" width="480" height="301" alt={name} class="h-auto w-[200px]" loading="lazy" decoding="async" />
    )
  }
</a>
