---
import { SITE } from '../consts';
import { BOOKING_OPTIONS } from '../data/pricing';

export interface Props {
  /** Prefix for field ids, so the form can appear more than once per page. */
  id?: string;
}
const { id = 'book' } = Astro.props;
const f = (name: string) => `${id}-${name}`;

const netlify = SITE.form.provider === 'netlify';
// Borders at 45% ink keep inputs at 3:1 against the white card (WCAG 1.4.11).
const field =
  'mt-1.5 w-full rounded-lg border border-inkk/45 bg-[#FCFCFA] px-3 py-3 text-[0.9375rem] text-inkk placeholder:text-inkk/60';
const label = 'block text-[0.8125rem] text-inkk/70';
---

<!--
  Static form. Submissions go to the provider set in src/consts.ts (SITE.form):
  - "formspree": posts to SITE.form.endpoint; Formspree's "_gotcha" honeypot drops bots.
  - "netlify":   Netlify Forms picks this form up at build time; "bot-field" is the honeypot.
  The provider stores and escapes submissions server-side; nothing secret lives here.
-->
<form
  name="booking"
  action={netlify ? '/thanks/' : SITE.form.endpoint}
  method="POST"
  data-netlify={netlify ? 'true' : undefined}
  netlify-honeypot={netlify ? 'bot-field' : undefined}
  aria-describedby={f('required-note')}
  class="rounded-[22px] bg-white p-7 ring-1 ring-inkk/10 sm:p-9"
>
  {netlify && <input type="hidden" name="form-name" value="booking" />}
  <p id={f('required-note')} class="mb-5 text-[0.8125rem] text-inkk/70">
    Fields marked <span aria-hidden="true">*</span><span class="sr-only">with an asterisk</span> are required.
  </p>
  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for={f('names')} class={label}>Your name(s) <span aria-hidden="true">*</span></label>
      <input id={f('names')} name="names" type="text" placeholder="Jake & Kenna" autocomplete="name" required maxlength="120" class={field} />
    </div>
    <div>
      <label for={f('date')} class={label}>Date</label>
      <input id={f('date')} name="date" type="date" class={field} />
    </div>
    <div>
      <label for={f('email')} class={label}>Email <span aria-hidden="true">*</span></label>
      <input id={f('email')} name="email" type="email" placeholder="you@email.com" autocomplete="email" required maxlength="200" class={field} />
    </div>
    <div>
      <label for={f('venue')} class={label}>Venue or town</label>
      <input id={f('venue')} name="venue" type="text" placeholder="Woodland, WA" autocomplete="address-level2" maxlength="160" class={field} />
    </div>
  </div>
  <div class="mt-4">
    <label for={f('package')} class={label}>What are you booking?</label>
    <select id={f('package')} name="package" class="mt-1.5 w-full rounded-lg border border-inkk/45 bg-[#FCFCFA] px-3 py-3 text-[0.9375rem] text-inkk">
      {BOOKING_OPTIONS.map((o) => <option>{o}</option>)}
    </select>
  </div>
  <div class="mt-4">
    <label for={f('message')} class={label}>Anything we should know</label>
    <textarea
      id={f('message')}
      name="message"
      rows="3"
      maxlength="4000"
      placeholder="Timeline, number of guests, drone or vertical videos, that one shot you want…"
      class={`${field} resize-y`}
    ></textarea>
  </div>

  <!-- Honeypot: hidden from people and assistive tech; bots that fill it are rejected by the provider. -->
  <div class="hidden" aria-hidden="true">
    <label>Leave this empty<input type="text" name={netlify ? 'bot-field' : '_gotcha'} tabindex="-1" autocomplete="off" /></label>
  </div>

  <button type="submit" class="mt-6 w-full rounded-full bg-spruce px-6 py-4 text-[0.9375rem] font-medium text-fog transition hover:bg-spruce2">
    Send request
  </button>
</form>
