---
import { SITE } from '../consts';
import { BOOKING_OPTIONS } from '../data/pricing';

const field =
  'mt-1.5 w-full rounded-lg border border-inkk/15 bg-[#FCFCFA] px-3 py-3 text-[15px] text-inkk placeholder:text-inkk/30';
const label = 'block text-[13px] text-inkk/50';
---

<!-- Static form: set SITE.formEndpoint in src/consts.ts to a Formspree/Basin/Netlify endpoint. -->
<form action={SITE.formEndpoint} method="POST" class="rounded-[22px] bg-white p-7 ring-1 ring-inkk/10 sm:p-9">
  <div class="grid gap-4 sm:grid-cols-2">
    <label class={label}>Your name(s)<input name="names" type="text" placeholder="Jake & Kenna" autocomplete="name" required class={field} /></label>
    <label class={label}>Date<input name="date" type="date" class={field} /></label>
    <label class={label}>Email<input name="email" type="email" placeholder="you@email.com" autocomplete="email" required class={field} /></label>
    <label class={label}>Venue or town<input name="venue" type="text" placeholder="Woodland, WA" class={field} /></label>
  </div>
  <label class={`mt-4 ${label}`}
    >What are you booking?<select name="package" class="mt-1.5 w-full rounded-lg border border-inkk/15 bg-[#FCFCFA] px-3 py-3 text-[15px] text-inkk">
      {BOOKING_OPTIONS.map((o) => <option>{o}</option>)}
    </select></label
  >
  <label class={`mt-4 ${label}`}
    >Anything we should know<textarea
      name="message"
      rows="3"
      placeholder="Timeline, number of guests, drone or vertical videos, that one shot you want…"
      class="mt-1.5 w-full resize-y rounded-lg border border-inkk/15 bg-[#FCFCFA] px-3 py-3 text-[15px] text-inkk"
    ></textarea></label
  >
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <button type="submit" class="mt-6 w-full rounded-full bg-spruce px-6 py-4 text-[15px] font-medium text-fog transition hover:bg-spruce2">
    Send request
  </button>
</form>
