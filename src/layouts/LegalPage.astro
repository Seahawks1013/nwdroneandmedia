---
// Shared shell for Privacy, Terms and the flight-safety disclaimer:
// short hero, "last updated" line, and readable long-form text styles.
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

export interface Props {
  title: string;
  description: string;
  updated: string;
  intro?: string;
}
const { title, description, updated, intro } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <PageHero eyebrow="Legal" title={title} intro={intro} />
  <section class="bg-fog py-20 sm:py-24">
    <article class="legal mx-auto max-w-[760px] px-6 sm:px-9">
      <p class="text-[0.8125rem] tracking-[.1em] text-inkk/70">Last updated {updated}</p>
      <slot />
    </article>
  </section>
</BaseLayout>

<style>
  .legal :global(h2) {
    margin-top: 3rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .legal :global(h3) {
    margin-top: 1.75rem;
    font-size: 1rem;
    font-weight: 600;
  }
  .legal :global(p),
  .legal :global(li) {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.75;
    color: rgb(18 26 23 / 0.75);
  }
  .legal :global(p) {
    margin-top: 1rem;
  }
  .legal :global(ul) {
    margin-top: 1rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .legal :global(li + li) {
    margin-top: 0.4rem;
  }
  .legal :global(li::marker) {
    color: var(--color-brass);
  }
  .legal :global(a) {
    color: var(--color-inkk);
    text-decoration: underline;
    text-decoration-color: var(--color-brass);
    text-underline-offset: 3px;
  }
</style>
